# Production Environment Variables Template
# コピーして .env.prod として使用してください: cp .env.production .env.prod

# === Neo4j Database ===
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
# ⚠️ IMPORTANT: Change this to a strong password!
NEO4J_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# === Server Configuration ===
PORT=3000
NODE_ENV=production

# === JWT Authentication ===
# ⚠️ IMPORTANT: Generate random 32+ character strings!
# 生成方法: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_RANDOM_32_CHAR_STRING
JWT_EXPIRES_IN=24h

# === Ollama Configuration (Optional - AI検索用) ===
# ローカルのOllamaを使う場合
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large

# === Frontend Configuration ===
FRONTEND_PORT=80

# === CORS Configuration ===
# 本番環境のフロントエンドURL
# CORS_ORIGIN=https://your-domain.com

# === Optional: Backup Configuration ===
# BACKUP_SCHEDULE=0 2 * * *  # 毎日午前2時
# BACKUP_RETENTION_DAYS=7

# === Optional: Monitoring ===
# LOG_LEVEL=info
# SENTRY_DSN=your-sentry-dsn
